# ---------------------------------------------------------------------------
# MediCare HMS - example environment file
# Copy this file to ".env" and change the values.
#   Windows :  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Which config class to load: development | testing | production
FLASK_CONFIG=development

# Required by Flask for sessions and CSRF tokens.
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# SQLite database. A relative path is resolved inside Flask's instance/ folder,
# so this creates  instance/hms.sqlite3  the first time the app starts.
DATABASE_URL=sqlite:///hms.sqlite3

# Seed administrator - created automatically on first run only (Task 3).
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@medicare-hms.com
ADMIN_PASSWORD=Admin@12345
